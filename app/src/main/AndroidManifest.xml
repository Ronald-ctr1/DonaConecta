<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="DonaConecta"
        android:supportsRtl="true"
        android:theme="@style/Theme.DonaConecta">

        <activity android:name=".auth.ActividadInicioSesion" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".auth.ActividadRegistro" android:exported="false" />
        <activity android:name=".publicacion.ActividadPanelPrincipal" android:exported="false" />
        <activity android:name=".publicacion.ActividadPublicarDonacion" android:exported="false" />
        <activity android:name=".publicacion.ActividadFotosDonacion"
            android:exported="false" android:screenOrientation="portrait" />
        <activity android:name=".ia.ActividadAnalisisIA" android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_archivos" />
        </provider>
    </application>
</manifest>
