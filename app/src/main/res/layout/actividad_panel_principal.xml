<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp">
    <TextView android:id="@+id/textoSaludo" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="Hola" android:textSize="26sp"
        android:textStyle="bold" />
    <TextView android:id="@+id/textoRol" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginBottom="24dp" />
    <Button android:id="@+id/botonPublicarDonacion" android:layout_width="match_parent"
        android:layout_height="56dp" android:text="Publicar donación" />
    <Button android:id="@+id/botonCerrarSesion" style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginTop="8dp" android:text="Cerrar sesión" />
</LinearLayout>
